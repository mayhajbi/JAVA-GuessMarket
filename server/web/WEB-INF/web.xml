<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>gm.server.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>EventsServlet</servlet-name>
        <servlet-class>gm.server.EventsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EventsServlet</servlet-name>
        <url-pattern>/events</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>EventStateServlet</servlet-name>
        <servlet-class>gm.server.EventStateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EventStateServlet</servlet-name>
        <url-pattern>/event/market</url-pattern>
        <url-pattern>/event/orderbook</url-pattern>
        <url-pattern>/event/prices</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>UsersServlet</servlet-name>
        <servlet-class>gm.server.UsersServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UsersServlet</servlet-name>
        <url-pattern>/users</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>AccountServlet</servlet-name>
        <servlet-class>gm.server.AccountServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AccountServlet</servlet-name>
        <url-pattern>/account</url-pattern>
        <url-pattern>/account/log</url-pattern>
        <url-pattern>/account/history</url-pattern>
        <url-pattern>/account/deposit</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>EventActionServlet</servlet-name>
        <servlet-class>gm.server.EventActionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EventActionServlet</servlet-name>
        <url-pattern>/event/open</url-pattern>
        <url-pattern>/event/close</url-pattern>
        <url-pattern>/event/buy</url-pattern>
        <url-pattern>/event/quote</url-pattern>
        <url-pattern>/event/order</url-pattern>
        <url-pattern>/event/create</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>UploadServlet</servlet-name>
        <servlet-class>gm.server.UploadServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UploadServlet</servlet-name>
        <url-pattern>/upload</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>ChatServlet</servlet-name>
        <servlet-class>gm.server.ChatServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ChatServlet</servlet-name>
        <url-pattern>/chat</url-pattern>
        <url-pattern>/chat/send</url-pattern>
    </servlet-mapping>
</web-app>
