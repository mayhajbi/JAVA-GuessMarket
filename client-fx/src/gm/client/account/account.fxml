<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="gm.client.account.AccountController">
    <VBox spacing="8">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="loadFileButton" text="Load file" onAction="#loadFile" minWidth="-Infinity"/>
            <TextField fx:id="filePathField" editable="false" promptText="File path" HBox.hgrow="ALWAYS"/>
            <ProgressBar fx:id="uploadProgress" prefWidth="140"/>
            <Label fx:id="uploadMessageLabel"/>
        </HBox>
        <SplitPane fx:id="splitPane" dividerPositions="0.5" VBox.vgrow="ALWAYS">
            <VBox spacing="6">
                <padding>
                    <Insets right="6"/>
                </padding>
                <Label text="Users" styleClass="section-title"/>
                <TableView fx:id="usersTable" prefHeight="150" minHeight="110">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="No other users yet." styleClass="placeholder" wrapText="true"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="userNameColumn" text="Name" prefWidth="160"/>
                        <TableColumn fx:id="userBalanceColumn" text="Balance" prefWidth="90"/>
                        <TableColumn fx:id="userMarketMakerColumn" text="Market maker" prefWidth="100"/>
                    </columns>
                </TableView>
                <Label text="Account details" styleClass="section-title"/>
                <TableView fx:id="accountEntriesTable" prefHeight="170" minHeight="110" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="No account activity yet." styleClass="placeholder" wrapText="true"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="entryTypeColumn" text="Type" prefWidth="120"/>
                        <TableColumn fx:id="entryAmountColumn" text="Amount" prefWidth="100"/>
                        <TableColumn fx:id="entryBalanceColumn" text="Balance" prefWidth="100"/>
                    </columns>
                </TableView>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label fx:id="userNameLabel" styleClass="section-title" minWidth="-Infinity"/>
                    <Label fx:id="blockedLabel" styleClass="blocked" text="Blocked - balance below zero" minWidth="-Infinity"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Account balance" styleClass="field-name" minWidth="-Infinity"/>
                    <Label fx:id="balanceLabel" styleClass="section-title" minWidth="-Infinity"/>
                    <Button text="Load funds" onAction="#loadFunds" minWidth="-Infinity"/>
                </HBox>
                <LineChart fx:id="balanceChart" prefHeight="200" minHeight="160" animated="false" createSymbols="false">
                    <xAxis>
                        <NumberAxis label="Seconds since the first change" forceZeroInRange="false"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Balance" forceZeroInRange="false"/>
                    </yAxis>
                </LineChart>
            </VBox>
            <VBox spacing="6">
                <padding>
                    <Insets left="6"/>
                </padding>
                <Label text="Your events" styleClass="section-title"/>
                <TableView fx:id="userEventsTable" prefHeight="150" minHeight="110">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="You are not part of any event yet." styleClass="placeholder" wrapText="true"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="userEventNameColumn" text="Event" prefWidth="200"/>
                        <TableColumn fx:id="userEventStatusColumn" text="Status" prefWidth="70"/>
                        <TableColumn fx:id="userEventTypeColumn" text="Type" prefWidth="85"/>
                        <TableColumn fx:id="userEventRoleColumn" text="Role" prefWidth="160"/>
                    </columns>
                </TableView>
                <fx:include fx:id="eventDetailComponent" source="/gm/ui/fx/eventdetail/eventdetail.fxml"
                            VBox.vgrow="ALWAYS"/>
            </VBox>
        </SplitPane>
    </VBox>
</ScrollPane>
